[Unit]
Description=Bambu Lab Telegram Print Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bambu-monitor
Group=bambu-monitor
ExecStart=/opt/bambu-telegram/venv/bin/python /opt/bambu-telegram/bambu_monitor.py --config /etc/bambu-telegram/config.yaml
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bambu-telegram

[Install]
WantedBy=multi-user.target
